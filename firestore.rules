rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ['papa@gmail.com', 'deksiman721@gmail.com'];
    }

    match /applications/{applicationId} {
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == 'submitted';

      allow get, list: if isAdmin()
        || (signedIn() && resource.data.ownerUid == request.auth.uid);

      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'reviewedBy', 'reviewedAt', 'updatedAt'])
        && request.resource.data.status in ['accepted', 'rejected']
        && request.resource.data.reviewedBy == request.auth.uid;

      allow delete: if isAdmin();
    }

    match /publicApplicants/{applicationId} {
      // Only accepted, deliberately limited public profile fields live here.
      allow get, list: if isAdmin() || resource.data.status == 'accepted';
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'name', 'job', 'country', 'pay', 'photoUrl', 'status', 'reference', 'reviewedAt'
        ])
        && request.resource.data.status == 'accepted';
      allow delete: if isAdmin();
    }
  }
}
